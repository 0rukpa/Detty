{
  "name": "detty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-system-ca.mjs next dev",
    "build": "next build",
    "start": "node scripts/with-system-ca.mjs next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/with-system-ca.mjs tsx scripts/seed.ts",
    "db:remove-demo": "node scripts/with-system-ca.mjs tsx scripts/remove-demo-data.mts",
    "vercel": "node scripts/with-system-ca.mjs npx vercel@latest",
    "deploy:env": "node scripts/with-system-ca.mjs node scripts/vercel-env.mjs",
    "deploy": "node scripts/with-system-ca.mjs npx vercel@latest --prod",
    "dev:verify-plug": "tsx scripts/dev-verify-plug.mts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
