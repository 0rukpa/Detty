# Copy to .env.local and fill in. Never commit real keys.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used later for Storage uploads and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> Database -> Connection string (Transaction pooler, port 6543)
DATABASE_URL=

# --- Stripe (test mode) - Phase 3 ---
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally, or the dashboard webhook in production.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Payout rail: "stripe" (default) or "mock" (TEST MODE ONLY: simulates payouts so the
# escrow -> withdraw flow can be demoed before Stripe Connect is fully enabled).
PAYOUT_PROVIDER=stripe

# --- Anthropic - Phase 7 (server only) ---
ANTHROPIC_API_KEY=

# --- Secrets for signed QR tickets and cron - Phase 3 ---
TICKET_SIGNING_SECRET=
CRON_SECRET=
